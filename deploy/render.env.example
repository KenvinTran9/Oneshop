# Enter these in Render Environment. Never upload your local .env.
SPRING_PROFILES_ACTIVE=prod
MYSQL_URL=jdbc:mysql://YOUR_SERVICE.aivencloud.com:YOUR_PORT/defaultdb?sslMode=VERIFY_IDENTITY&connectionTimeZone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8
MYSQL_USERNAME=avnadmin
MYSQL_PASSWORD=FILL_IN_RENDER
MYSQL_CA_CERT_PATH=/etc/secrets/aiven-ca.pem
# prepare_render.py fills this automatically. Alternative: upload the CA as a Secret File.
MYSQL_CA_CERT_BASE64=BASE64_OF_THE_PUBLIC_AIVEN_CA_CERTIFICATE
JWT_SECRET=GENERATE_NEW_BASE64_KEY_AT_LEAST_32_RANDOM_BYTES
JWT_ISSUER=oneshop
JWT_ACCESS_TOKEN_EXPIRATION_MILLIS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MILLIS=604800000
APP_BASE_URL=https://YOUR_SERVICE.onrender.com
MAIL_PROVIDER=resend
# Keep false until the API key/from address is configured, then set true.
MAIL_ENABLED=false
MAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=FILL_IN_RENDER
CLOUDINARY_CLOUD_NAME=FILL_IN_RENDER
CLOUDINARY_API_KEY=FILL_IN_RENDER
CLOUDINARY_API_SECRET=FILL_IN_RENDER
