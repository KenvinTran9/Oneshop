# Copy these names into your environment or secret manager.
# Never use this placeholder as a real key.
JWT_SECRET=REPLACE_WITH_A_BASE64_ENCODED_RANDOM_SECRET
JWT_ISSUER=oneshop
JWT_ACCESS_TOKEN_EXPIRATION_MILLIS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MILLIS=604800000

# Dev only. Demo accounts are skipped when these values are empty.
DEMO_ADMIN_PASSWORD=REPLACE_WITH_A_LOCAL_DEMO_PASSWORD
DEMO_CUSTOMER_PASSWORD=REPLACE_WITH_A_LOCAL_DEMO_PASSWORD

# MongoDB: dev defaults to this local database; prod requires MONGODB_URI explicitly.
MONGODB_URI=mongodb://127.0.0.1:27017/oneshop
# Integration tests use a random isolated database on this connection.
ONESHOP_TEST_MONGODB_URI=mongodb://127.0.0.1:27017
# Dev-only demo inventory. Existing stock records (including zero) are never changed.
APP_DEV_SEED_STOCK=true

# Optional Cloudinary integration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
