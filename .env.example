# Dev imports .env as Java properties; prod uses environment/secret-manager values.
# Never use this placeholder as a real key.
JWT_SECRET=REPLACE_WITH_A_BASE64_ENCODED_RANDOM_SECRET
JWT_ISSUER=oneshop
JWT_ACCESS_TOKEN_EXPIRATION_MILLIS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MILLIS=604800000

# Dev only. Demo accounts are skipped when these values are empty.
DEMO_ADMIN_PASSWORD=
DEMO_CUSTOMER_PASSWORD=

# MySQL 8.4 local. Create oneshop_mysql before running the application.
# Local-only connection parameters; use verified TLS for remote/prod MySQL.
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/oneshop_mysql?allowPublicKeyRetrieval=true&useSSL=false&connectionTimeZone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8
MYSQL_USERNAME=root
MYSQL_PASSWORD=REPLACE_WITH_YOUR_LOCAL_MYSQL_PASSWORD
# Tests always replace the database name with oneshop_test_<uuid>.
# Optional override for a dedicated test server:
# ONESHOP_TEST_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/oneshop_mysql?allowPublicKeyRetrieval=true&useSSL=false
# Dev-only demo inventory. Existing stock records (including zero) are never changed.
APP_DEV_SEED_STOCK=true
APP_SEED_ENABLED=true

# Optional Cloudinary integration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail: enable 2-Step Verification, then generate an App Password (not your Gmail password).
# Remove spaces in the App Password. Never commit .env.
MAIL_ENABLED=false
MAIL_PROVIDER=smtp
# Render Free uses HTTPS Resend instead of SMTP. See docs/deploy-render-aiven.md.
RESEND_API_KEY=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
APP_BASE_URL=http://localhost:8080
ORDER_SHIPPING_FEE=30000
