# Copy to C:\OneShop\.env.aiven (ignored by Git). Plain KEY=value, no quotes.
# Download the service's CA certificate from Aiven to backups/aiven-ca.pem.
AIVEN_HOST=YOUR_SERVICE.aivencloud.com
AIVEN_PORT=YOUR_PORT
AIVEN_DATABASE=defaultdb
AIVEN_USERNAME=avnadmin
AIVEN_PASSWORD=FILL_LOCALLY_NOT_IN_CHAT
AIVEN_CA_CERT=backups/aiven-ca.pem
