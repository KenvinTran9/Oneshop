# Copy these names into your environment or secret manager.
# Never use this placeholder as a real key.
JWT_SECRET=REPLACE_WITH_A_BASE64_ENCODED_RANDOM_SECRET
JWT_ISSUER=oneshop
JWT_ACCESS_TOKEN_EXPIRATION_MILLIS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MILLIS=604800000

# Optional integrations and database profiles
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MYSQL_URL=jdbc:mysql://localhost:3306/oneshop
MYSQL_USERNAME=root
MYSQL_PASSWORD=
POSTGRES_URL=jdbc:postgresql://localhost:5432/oneshop
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
SQLSERVER_URL=jdbc:sqlserver://localhost:1433;databaseName=oneshop;encrypt=true;trustServerCertificate=true
SQLSERVER_USERNAME=sa
SQLSERVER_PASSWORD=
